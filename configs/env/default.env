PHP_ENABLE_XDEBUG=false
MAGENTO_RUN_MODE=developer
PHP_MEMORY_LIMIT=4G

# Container shell/PHP-CLI locale. C.UTF-8 is built into glibc (no locale-gen
# needed), fully UTF-8 (Cyrillic input works), and locale-neutral. The Magento
# STORE locale is separate (magento.locale.code → general/locale/code).
# To use a named locale instead (en_US.UTF-8 / ru_RU.UTF-8) the base image must
# have it generated — both are in images/services/magento/base/Dockerfile.
LANG=C.UTF-8
LC_ALL=C.UTF-8
